{
	"compilerOptions": {
		"declaration": true, // Generates .d.ts files
		"emitDeclarationOnly": true, // Only output .d.ts files
		"allowJs": true, // Allows JS files
		"rootDir": "src",
		"outDir": "types", // Output directory for type files
		"module": "Node16",
		"moduleResolution": "node16",
		"skipLibCheck": true,
		"esModuleInterop": true,
		"types": [
			"vitest/globals"
		]
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"./src/ignoreFolder/**/*",
		"./src/ignoreMe.js"
	]
}